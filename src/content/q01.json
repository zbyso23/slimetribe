      },
      {
        "id": "q01_meet_refugees",
        "name": "Příchod: refugees",
        "once": true,
        "trigger": {
          "type": "signal",
          "ref": "q01_meet_refugees"
        },
        "condition": null,
        "actions": [
          {
            "type": "message",
            "text": "Uprchlík: Naše jádra slábnou. Za branou je voda, kterou potřebujeme. Nechceme bojovat — potřebujeme projít. Zeptej se Serena, proč nás drží venku."
          },
          {
            "type": "flag",
            "flag": "q01_met_refugees",
            "value": true
          }
        ]
      },
      {
        "id": "q01_meet_seren",
        "name": "Příchod: seren",
        "once": true,
        "trigger": {
          "type": "signal",
          "ref": "q01_meet_seren"
        },
        "condition": null,
        "actions": [
          {
            "type": "message",
            "text": "Seren: Nechci hrdiny. Chci, aby ti za námi přežili. Projdi se po hrázi a vyslechni uprchlíky. Pokud nám potom pomůžeš chránit zásobovací průchod, dojdi k označené hlídce a stiskni E. Do té doby nikam nespěcháme."
          },
          {
            "type": "flag",
            "flag": "q01_met_seren",
            "value": true
          }
        ]
      }
