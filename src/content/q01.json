  "scenario": {
    "version": 1,
    "rules": [
      {
        "id": "q01_intro",
        "name": "q01 intro",
        "once": true,
        "trigger": {
          "type": "start"
        },
        "condition": null,
        "actions": [
          {
            "type": "cutscene",
            "ref": "q01_intro"
          },
          {
            "type": "objective",
            "text": "Prozkoumej okolí Zelené hráze. Promluv s uprchlíky a se Serenem. K obraně průchodu se vydej, až budeš připravený."
          }
        ]
      },
      {
        "id": "q01_choice",
        "name": "q01 choice",
        "once": true,
        "trigger": {
          "type": "victory",
          "ref": "q01_scout"
        },
        "condition": null,
        "actions": [
          {
            "type": "choice",
            "text": "Uprchlíci před branou slábnou. Jak otevřeme průchod? Volba hráz nezachrání; mění záchranu, důvěru a čas na evakuaci.",
            "flag": "q01_gate_policy",
            "options": [
              {
                "label": "OPEN · otevřít: více zachráněných hned, riziko průniku; 20 tahů",
                "value": "OPEN"
              },
              {
                "label": "HOLD · držet: ztráty před branou, více času uvnitř; 28 tahů",
                "value": "HOLD"
              },
              {
                "label": "PARTIAL · částečně: potřebuje doprovod; 24 tahů",
                "value": "PARTIAL"
              }
            ]
          },
          {
            "type": "message",
            "text": "Seren: Rozkaz je rozkaz. Ale odpovědnost zůstane nám. Irik nachází pod zdivem starší znaky; za růstem tlaku stojí mechanismus, ne jediný národ. Nara: „Počítáš mezi ty, které chráníš, i naše?“ Seren: „Koho jiného bych měl počítat?“ Nara chvíli neodpoví."
          },
          {
            "type": "cutscene",
            "ref": "q01_pressure"
          },
          {
            "type": "objective",
            "text": "Ovládni dva ventily, doprovoď poslední skupinu a unikni. Fragment na východním břehu je volitelný."
          }
        ]
      },
      {
        "id": "q01_warning",
        "name": "q01 warning",
        "once": true,
        "trigger": {
          "type": "signal",
          "ref": "q01_warning"
        },
        "condition": null,
        "actions": [
          {
            "type": "message",
            "text": "VAROVÁNÍ: Za 1 tah proud uzavře horní přechod [7,4]. Spodní most [7,8] zůstane průchozí. Čas běží jen po krocích na mapě nebo po Vyčkat."
          }
        ]
      },
      {
        "id": "q01_collapse",
        "name": "q01 collapse",
        "once": true,
        "trigger": {
          "type": "signal",
          "ref": "q01_collapse"
        },
        "condition": null,
        "actions": [
          {
            "type": "cutscene",
            "ref": "q01_fall"
          },
          {
            "type": "objective",
            "text": "Zelená hráz padla. Zhodnoť záchranu a vydej se do bažin."
          }
        ]
      },
      {
        "id": "q02_teaser",
        "name": "q02 teaser",
        "once": true,
        "trigger": {
          "type": "signal",
          "ref": "q02_teaser"
