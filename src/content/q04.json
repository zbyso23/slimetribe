      "id": "bridge_switch",
      "x": 10,
      "y": 7,
      "type": "sign",
      "text": "Živý most má klidovou podobu a dvě proměny. V první naslouchej východnímu břehu, v druhé západnímu."
    },
    {
      "id": "bank_a",
      "x": 9,
      "y": 5,
      "type": "sign",
      "text": "První břeh potřebuje první proměnu mostu."
    },
