      "id": "sarym",
      "x": 9,
      "y": 2,
      "type": "sign",
      "text": "Sarymina runa vyžaduje bezpečný návrat z obou proměn."
    },
    {
      "id": "memory_a",
      "x": 2,
      "y": 7,
      "type": "sign",
      "text": "První svědectví: zadržení vody chránilo tehdejší věk. Tím začíná posloupnost."
    },
    {
      "id": "memory_b",
      "x": 3,
      "y": 8,
      "type": "sign",
      "text": "Druhé svědectví: živá paměť přežila změnu. Navazuje na ochranu starého věku."
    },
    {
      "id": "memory_c",
      "x": 7,
      "y": 8,
      "type": "sign",
      "text": "Třetí svědectví: opis změnil kroniku. Porovnej jej až po ochraně a živé paměti."
    },
    {
      "id": "gate",
      "x": 6,
      "y": 2,
      "type": "sign",
      "text": "Společná brána. Tři samostatné runy vytvoří jediný klíč."
    }
