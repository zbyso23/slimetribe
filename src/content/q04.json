      "cues": [
        {
          "t": 0.0,
          "text": "Irik: Čtvrté svědectví nebylo ztraceno. Někdo je skryl.",
          "music": "ambient",
          "sfx": ""
        },
        {
          "t": 2.6666666666666665,
          "text": "Ruenova ozvěna: Viděl jsem přicházející konec. Zvolil jsem špatný okamžik.",
          "music": "",
          "sfx": ""
        },
        {
          "t": 5.333333333333333,
          "text": "Talren, Sarym a Móren zachránili svůj věk. Ochrana však neměla trvat navždy.",
          "music": "",
          "sfx": ""
        },
        {
          "t": 8.0,
          "text": "Aela: My jsme zachránili svůj věk. Vy musíte zachránit svůj.",
          "music": "",
          "sfx": ""
        },
        {
          "t": 10.666666666666666,
          "text": "Čtvrtá přísaha: stará ochrana musí skončit, pokud působí více utrpení než nebezpečí.",
          "music": "",
          "sfx": ""
        },
        {
          "t": 13.333333333333334,
          "text": "Nara: Auralis pije z vody, kterou nazývá jen svou. Jeho prameny patří do společného koloběhu.",
          "music": "",
          "sfx": ""
        }
      ]
    },
