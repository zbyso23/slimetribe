        "actions": [
          {
            "type": "cutscene",
            "ref": "q02_sarym"
          },
          {
            "type": "choice",
            "text": "Tři uzly jsou stabilní. Jak uklidníme strážce a zabráníme ovládnutí svatyně? Každá cesta zachová nezbytný fragment.",
            "flag": "q02_approach",
            "options": [
              {
                "label": "CARE · péče: 4 tahy práce, léčení živých spojenců; více důvěry",
                "value": "CARE"
              },
              {
                "label": "FORCE · síla: střet s radikály, riziko ztrát a menší důvěra",
                "value": "FORCE"
              },
              {
                "label": "NEGOTIATE · dohoda: pomůže důvěra nebo svědek; jinak 6 tahů práce",
                "value": "NEGOTIATE"
              }
            ]
          },
          {
            "type": "objective",
            "text": "Dokonči zvolený způsob uklidnění svatyně."
          }
        ]
      },
