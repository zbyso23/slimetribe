          "type": "victory",
          "ref": "q02_sanctuary"
        },
        "condition": null,
        "actions": [
          {
            "type": "message",
            "text": "Léčitel: Místní jsou v bezpečí. Zbývá uklidnit tři uzly živé paměti. Seren: „V těch kořenech se nevyznám.“ Nara: „Tak se drž poblíž.“ Seren: „To zvládnu.“"
          },
          {
            "type": "objective",
            "text": "Stabilizuj všechny tři uzly [4,3], [8,4], [7,7]. Svědek [9,7] může pomoci s vyjednáváním."
          }
        ]
      },
      {
        "id": "q02_nodes",
